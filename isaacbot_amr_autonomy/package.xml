<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isaacbot_amr_autonomy</name>
  <version>1.0.0</version>
  <description>
    Metapackage grouping the autonomy packages that run on the Ardennes orchestrator computer.
  </description>
  <maintainer email="potlogradu@gmail.com">radupotlog</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>isaacbot_amr_drive_mode</depend>
  <depend>isaacbot_amr_follow_me</depend>
  <depend>isaacbot_amr_indoor_nav_manager</depend>
  <depend>isaacbot_amr_mission_manager</depend>
  <depend>isaacbot_amr_navigation</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
